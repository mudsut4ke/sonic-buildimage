{
    "component_num": 6,
    "get_name": {
        "output_source": "value_list",
        "value_list": [
            "BIOS",
            "BMC",
            "CPLD1",
            "CPLD2",
            "CPLD3",
            "CPLD4"
        ]
    },
    "get_description": {
        "output_source": "value_list",
        "value_list": [
            "Used to perform hardware initialization during the booting process",
            "Used for monitoring and managing whole system",
            "Used to control the system power & reset, Control FAN, UART Mux etc",
            "Used for managing QSFP ports",
            "Used for managing QSFP ports",
            "Used for managing QSFP ports",
            "Used for managing QSFP ports"
        ]
    },
    "get_firmware_version": {
        "output_source": "function",
        "function": [
            "_get_bios_ver",
            "_get_bmc_ver",
            "_get_cpld1_ver",
            "_get_cpld2_ver",
            "_get_cpld3_ver",
            "_get_cpld4_ver"
        ]
    },
    "_get_bmc_ver": {
        "output_source": "ipmitool",
        "command": "ipmitool mc info | grep 'Firmware Revision'",
        "output_translator": "'{}'.split(':')[-1].strip()"
    },
    "_get_bios_ver": {
        "output_source": "txt_file",
        "path": "/sys/class/dmi/id/bios_version"
    },
    "_get_cpld1_ver": {
        "output_source": "hex_version_getreg",
        "num_of_points": 1,
        "num_of_bits": 8,
        "reg_addr": "0xA100",
        "path": "/sys/devices/platform/ms200i_cpld/get_reg"
    },
    "_get_cpld2_ver": {
        "output_source": "hex_version_getreg",
        "num_of_points": 1,
        "num_of_bits": 8,
        "reg_addr": "0xA200",
        "path": "/sys/devices/platform/ms200i_cpld/get_reg"
    },
    "_get_cpld3_ver": {
        "output_source": "hex_version_getreg",
        "num_of_points": 1,
        "num_of_bits": 8,
        "reg_addr": "0xA2C0",
        "path": "/sys/devices/platform/ms200i_cpld/get_reg"
    },
    "_get_cpld4_ver": {
        "output_source": "hex_version_getreg",
        "num_of_points": 1,
        "num_of_bits": 8,
        "reg_addr": "0xA300",
        "path": "/sys/devices/platform/ms200i_cpld/get_reg"
    }
}